# Doxygen validation for the maintainable C cartridge implementation.
# SPDX-License-Identifier: GPL-3.0-only

PROJECT_NAME = "P2000T Teletekst cartridge"
OUTPUT_DIRECTORY = /tmp/p2000t-cartridge-doxygen
INPUT = src
FILE_PATTERNS = *.c *.h
RECURSIVE = NO
EXTRACT_ALL = NO
EXTRACT_STATIC = YES
HIDE_UNDOC_MEMBERS = NO
HIDE_UNDOC_CLASSES = NO
JAVADOC_AUTOBRIEF = YES
OPTIMIZE_OUTPUT_FOR_C = YES
PREDEFINED = __z88dk_fastcall=
WARNINGS = YES
WARN_IF_UNDOCUMENTED = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_NO_PARAMDOC = YES
WARN_IF_DOC_ERROR = YES
WARN_AS_ERROR = FAIL_ON_WARNINGS
# Doxygen 1.9.8 needs an enabled documentation renderer for parameter/return
# validation; XML-only output produces false WARN_NO_PARAMDOC failures.
GENERATE_HTML = YES
# This is a documentation lint job; graph rendering is unnecessary.
HAVE_DOT = NO
GENERATE_XML = YES
GENERATE_LATEX = NO
QUIET = YES
