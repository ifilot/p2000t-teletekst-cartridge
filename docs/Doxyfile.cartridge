# Doxygen validation for the maintainable C cartridge implementation.
# SPDX-License-Identifier: GPL-3.0-only

PROJECT_NAME = "P2000T Teletekst cartridge C port"
OUTPUT_DIRECTORY = /tmp/p2000t-cartridge-doxygen
INPUT = src/cartridge-c
FILE_PATTERNS = *.c *.h
RECURSIVE = NO
EXTRACT_ALL = NO
EXTRACT_STATIC = YES
HIDE_UNDOC_MEMBERS = NO
HIDE_UNDOC_CLASSES = NO
JAVADOC_AUTOBRIEF = YES
OPTIMIZE_OUTPUT_FOR_C = YES
PREDEFINED = __z88dk_fastcall=
WARNINGS = YES
WARN_IF_UNDOCUMENTED = YES
WARN_IF_DOC_ERROR = YES
WARN_AS_ERROR = FAIL_ON_WARNINGS
GENERATE_HTML = NO
GENERATE_XML = YES
GENERATE_LATEX = NO
QUIET = YES
