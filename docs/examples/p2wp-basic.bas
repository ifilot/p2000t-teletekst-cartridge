10 REM P2WP/2 HELLO AND ECHO DIAGNOSTIC FOR PHILIPS P2000T BASIC
20 CLEAR 1000
30 DIM B%(247),R%(247),P%(240)
40 SQ%=0
50 PRINT "P2WP/2 BASIC LINK TEST"
60 REM HELLO: "P2WP", MIN=2, MAX=2, RECEIVE LIMIT=240
70 TY%=1:PL%=8
80 P%(0)=80:P%(1)=50:P%(2)=87:P%(3)=80
90 P%(4)=2:P%(5)=2:P%(6)=240:P%(7)=0
100 GOSUB 6000
110 IF ER%<>0 THEN PRINT "HELLO ERROR";ER%:STOP
120 IF R%(4)<>8 OR R%(6)<>80 OR R%(7)<>50 THEN PRINT "BAD HELLO":STOP
130 PRINT "VERSION";R%(10);" CAPABILITIES";R%(11)
140 PRINT "MAX PAYLOAD";R%(12)+256*R%(13)
150 SQ%=(SQ%+1) AND 255
160 REM ECHO THE FIVE ASCII BYTES "BASIC"
170 TY%=2:PL%=5
180 P%(0)=66:P%(1)=65:P%(2)=83:P%(3)=73:P%(4)=67
190 GOSUB 6000
200 IF ER%<>0 THEN PRINT "ECHO ERROR";ER%:STOP
210 IF R%(4)<>5 THEN PRINT "BAD ECHO LENGTH":STOP
220 PRINT "ECHO: ";
230 FOR I%=0 TO 4:PRINT CHR$(R%(6+I%));:NEXT I%
240 PRINT
250 END

1000 REM BUILD UNESCAPED REQUEST BODY AND ITS CRC
1010 BL%=6+PL%
1020 B%(0)=2:B%(1)=0:B%(2)=TY%:B%(3)=SQ%
1030 B%(4)=PL% AND 255:B%(5)=INT(PL%/256)
1040 IF PL%=0 THEN 1070
1050 FOR I%=0 TO PL%-1:B%(6+I%)=P%(I%):NEXT I%
1070 H%=255:L%=255:I%=0
1080 IF I%>=BL% THEN 1110
1090 C%=B%(I%):GOSUB 2000:I%=I%+1:GOTO 1080
1110 C0%=L%:C1%=H%
1120 RETURN

2000 REM CRC-16/CCITT-FALSE UPDATE: C%=BYTE, H%:L%=CRC
2010 H%=H% XOR C%:N%=8
2020 K%=H% AND 128
2030 H%=((H%*2) AND 255)+INT(L%/128)
2040 L%=(L%*2) AND 255
2050 IF K%=0 THEN 2070
2060 H%=H% XOR 16:L%=L% XOR 33
2070 N%=N%-1:IF N%>0 THEN 2020
2080 RETURN

3000 REM SEND COMPLETE FRAME
3010 ER%=0:X%=126:GOSUB 3400
3020 IF ER%<>0 THEN RETURN
3030 I%=0
3040 IF I%>=BL% THEN 3080
3050 X%=B%(I%):GOSUB 3200
3060 IF ER%<>0 THEN RETURN
3070 I%=I%+1:GOTO 3040
3080 X%=C0%:GOSUB 3200:IF ER%<>0 THEN RETURN
3090 X%=C1%:GOSUB 3200:IF ER%<>0 THEN RETURN
3100 X%=126:GOSUB 3400
3110 RETURN

3200 REM SEND X%, ESCAPING 125 AND 126
3210 Y%=X%
3220 IF X%=125 OR X%=126 THEN 3250
3230 GOSUB 3400
3240 RETURN
3250 X%=125:GOSUB 3400
3260 IF ER%<>0 THEN RETURN
3270 X%=Y% XOR 32:GOSUB 3400
3280 RETURN

3400 REM SEND RAW X% WITH A FINITE TX_READY TIMEOUT
3410 W%=30000
3420 IF (INP(&H42) AND 2)<>0 THEN OUT &H40,X%:RETURN
3430 W%=W%-1:IF W%>0 THEN 3420
3440 ER%=2
3450 RETURN

4000 REM RECEIVE AND UNESCAPE ONE FRAME INTO R%()
4010 ER%=0
4020 GOSUB 4600
4030 IF ER%<>0 THEN RETURN
4040 IF X%<>126 THEN 4020
4050 RL%=0:ES%=0
4060 GOSUB 4600
4070 IF ER%<>0 THEN RETURN
4080 IF X%<>126 THEN 4130
4090 IF RL%=0 THEN 4060
4100 IF ES%<>0 THEN ER%=4
4110 RETURN
4130 IF ES%=0 THEN 4160
4140 X%=X% XOR 32:ES%=0:GOTO 4200
4160 IF X%<>125 THEN 4200
4170 ES%=1:GOTO 4060
4200 IF RL%>247 THEN ER%=5:RETURN
4210 R%(RL%)=X%:RL%=RL%+1
4220 GOTO 4060

4600 REM RECEIVE RAW X% WITH A FINITE RX_READY TIMEOUT
4610 W%=30000
4620 IF (INP(&H42) AND 1)<>0 THEN X%=INP(&H41):RETURN
4630 W%=W%-1:IF W%>0 THEN 4620
4640 ER%=3
4650 RETURN

5000 REM VALIDATE LENGTH, CRC, VERSION, FLAGS, TYPE, AND SEQUENCE
5010 ER%=6
5020 IF RL%<8 THEN RETURN
5030 RP%=R%(4)+256*R%(5)
5040 IF RP%>240 OR RL%<>RP%+8 THEN RETURN
5050 H%=255:L%=255:I%=0
5060 IF I%>=RL%-2 THEN 5090
5070 C%=R%(I%):GOSUB 2000:I%=I%+1:GOTO 5060
5090 IF R%(RL%-2)<>L% OR R%(RL%-1)<>H% THEN RETURN
5100 IF R%(0)<>2 OR R%(2)<>TY% OR R%(3)<>SQ% THEN RETURN
5110 F%=R%(1) AND 3
5120 IF F%<>3 THEN 5150
5130 IF RP%>0 THEN ER%=100+R%(6)
5140 RETURN
5150 IF F%<>1 THEN RETURN
5160 ER%=0
5170 RETURN

6000 REM STOP-AND-WAIT TRANSACTION WITH THREE IDENTICAL ATTEMPTS
6010 GOSUB 1000:A%=3
6020 GOSUB 3000
6030 IF ER%=0 THEN GOSUB 4000
6040 IF ER%=0 THEN GOSUB 5000
6050 IF ER%=0 OR ER%>=100 THEN RETURN
6060 A%=A%-1:IF A%>0 THEN 6020
6070 RETURN
