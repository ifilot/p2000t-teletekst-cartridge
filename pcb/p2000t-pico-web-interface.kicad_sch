	)
	(text "Capture port 0x40"
		(exclude_from_sim no)
		(at 28.448 130.048 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "09fd112e-0aa5-4afe-98a1-686afa7d64ea")
	)
	(text "TX_FULL: Byte is ready to be received by PICO\n~{TX_CLR}: PICO is ready to receive next byte\nRX_READY: Byte is ready to be received by P2000T\n~{RX_ACK_CLR}: Clear acknowledge line\nRX_ACK_PENDING: Byte is ready to be received by P2000T\n"
		(exclude_from_sim no)
		(at 169.926 18.542 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "15065808-79ca-4b94-a3bf-5f689efd94a3")
	)
	(text "output\nregister"
		(exclude_from_sim no)
		(at 128.016 155.194 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "2f2a301f-225c-4826-9526-a5bcf3f11884")
	)
	(text "When the P2000T sends a byte, the input register is loaded and\nTX_FULL is set high and TX_READY is low. The PICO can then\nread this byte and signal TX_CLR when it has succesfully\nread the byte."
		(exclude_from_sim no)
		(at 14.478 112.014 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "34c09cf3-d022-4809-8eab-f6a29102f7c9")
	)
	(text "OUTPUT"
		(exclude_from_sim no)
		(at 204.216 72.644 90)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "352ba517-8515-4833-9b33-f6e133e4e4ec")
	)
	(text "CONTROL LINES"
		(exclude_from_sim no)
		(at 185.928 77.978 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "40efa453-02f2-4eb7-8146-9ea2a82a63c0")
	)
	(text "When the PICO has a byte for the P2000T, it sets RX_READY high.\nWhen the P2000T reads the byte, it sets RX_ACK_PENDING high,\nacknowledging that a byte has been read. The PICO then sets\nthis byte low again, confirming it knows that a byte has been\nread."
		(exclude_from_sim no)
		(at 86.36 111.76 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "5e686c04-1556-493e-b728-6263c7cafc12")
	)
	(text "control\nregister"
		(exclude_from_sim no)
		(at 128.016 172.974 0)
